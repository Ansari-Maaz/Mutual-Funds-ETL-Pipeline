PORT=3001
# Optional; by default the API reads DATABASE_URL from the project root .env.
# DATABASE_URL=postgresql://db_user:replace_me@localhost:5433/mfetl
PYTHON_EXECUTABLE=./.venv/bin/python
ETL_TIMEOUT_MS=900000
ADMIN_API_KEY=replace_with_a_long_random_secret
TRUST_PROXY_HOPS=1
FRONTEND_ORIGIN=http://localhost:5173
LOG_LEVEL=info
