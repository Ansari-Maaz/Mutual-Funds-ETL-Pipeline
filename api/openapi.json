{
  "openapi": "3.0.3",
  "info": {
    "title": "FundFlow API",
    "version": "1.0.0",
    "description": "REST endpoints for database-backed mutual-fund records, NAV history, portfolio holdings, source coverage, and ETL runs. Null values mean that the source did not provide the field."
  },
  "servers": [{ "url": "/api/v1", "description": "Current FundFlow API host" }],
  "tags": [
    { "name": "Health" },
    { "name": "Catalog" },
    { "name": "Funds" },
    { "name": "ETL" }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": ["Health"],
        "summary": "Check API and database status",
        "description": "Returns API status, latest ETL status, or PostgreSQL connectivity. A database connection does not imply that records are populated.",
        "operationId": "getHealth",
        "responses": {
          "200": { "description": "Health status returned" },
          "503": { "$ref": "#/components/responses/DatabaseUnavailable" }
        }
      }
    },
    "/health/database": {
      "get": {
        "tags": ["Health"],
        "summary": "Check PostgreSQL connectivity",
        "operationId": "getDatabaseHealth",
        "responses": {
          "200": { "description": "Database is reachable" },
          "503": { "$ref": "#/components/responses/DatabaseUnavailable" }
        }
      }
    },
    "/health/etl": {
      "get": {
        "tags": ["Health"],
        "summary": "Get latest ETL run status",
        "operationId": "getLatestEtlHealth",
        "responses": { "200": { "description": "Latest run status returned" } }
      }
    },
    "/stats": {
      "get": {
        "tags": ["Catalog"],
        "summary": "Get database statistics",
        "description": "Counts funds and NAV records directly from the configured PostgreSQL database.",
        "operationId": "getStats",
        "responses": { "200": { "description": "Current database counts returned" }, "500": { "$ref": "#/components/responses/ApiError" } }
      }
    },
    "/countries": {
      "get": {
        "tags": ["Catalog"],
        "summary": "List country coverage",
        "operationId": "listCountries",
        "responses": { "200": { "description": "Configured countries and stored counts returned" }, "500": { "$ref": "#/components/responses/ApiError" } }
      }
    },
    "/sources": {
      "get": {
        "tags": ["Catalog"],
        "summary": "List registered sources",
        "operationId": "listSources",
        "responses": { "200": { "description": "Sources and database counts returned" }, "500": { "$ref": "#/components/responses/ApiError" } }
      }
    },
    "/sources/{source_id}": {
      "get": {
        "tags": ["Catalog"],
        "summary": "Get a registered source",
        "operationId": "getSource",
        "parameters": [{ "$ref": "#/components/parameters/SourceId" }],
        "responses": { "200": { "description": "Source returned" }, "404": { "$ref": "#/components/responses/ApiError" } }
      }
    },
    "/sources/{source_id}/check": {
      "post": {
        "tags": ["Catalog"],
        "summary": "Check an official source endpoint",
        "description": "Administrator-only, rate-limited connectivity check. It does not validate source data or confirm a successful import.",
        "operationId": "checkSource",
        "security": [{ "AdminApiKey": [] }],
        "parameters": [{ "$ref": "#/components/parameters/SourceId" }],
        "responses": {
          "200": { "description": "Source is reachable" },
          "401": { "$ref": "#/components/responses/ApiError" },
          "422": { "description": "No valid configured endpoint is available" },
          "502": { "description": "Connectivity check failed" }
        }
      }
    },
    "/funds": {
      "get": {
        "tags": ["Funds"],
        "summary": "Search and filter funds",
        "operationId": "listFunds",
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "minimum": 1, "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 25 } },
          { "name": "q", "in": "query", "description": "Name or identifier search", "schema": { "type": "string" } },
          { "name": "country", "in": "query", "schema": { "type": "string", "minLength": 2, "maxLength": 2 } },
          { "name": "currency", "in": "query", "schema": { "type": "string", "minLength": 3, "maxLength": 3 } },
          { "name": "isin", "in": "query", "schema": { "type": "string" } },
          { "name": "category", "in": "query", "schema": { "type": "string" } },
          { "name": "fund_type", "in": "query", "schema": { "type": "string" } },
          { "name": "status", "in": "query", "schema": { "type": "string" } },
          { "name": "has_nav", "in": "query", "schema": { "type": "boolean" } },
          { "name": "holdings_status", "in": "query", "schema": { "type": "string", "enum": ["available", "unavailable", "not_checked"] } },
          { "name": "sort", "in": "query", "schema": { "type": "string", "enum": ["name", "country", "currency", "retrieved_at"], "default": "name" } },
          { "name": "order", "in": "query", "schema": { "type": "string", "enum": ["asc", "desc"], "default": "asc" } }
        ],
        "responses": { "200": { "description": "Paginated database records returned" }, "400": { "$ref": "#/components/responses/ApiError" }, "500": { "$ref": "#/components/responses/ApiError" } }
      }
    },
    "/funds/{fund_id}": {
      "get": {
        "tags": ["Funds"],
        "summary": "Get fund profile",
        "operationId": "getFund",
        "parameters": [{ "$ref": "#/components/parameters/FundId" }],
        "responses": { "200": { "description": "Fund and latest stored NAV returned" }, "404": { "$ref": "#/components/responses/ApiError" } }
      }
    },
    "/funds/{fund_id}/nav": {
      "get": {
        "tags": ["Funds"],
        "summary": "Get NAV history",
        "operationId": "getFundNav",
        "parameters": [
          { "$ref": "#/components/parameters/FundId" },
          { "name": "from", "in": "query", "schema": { "type": "string", "format": "date" } },
          { "name": "to", "in": "query", "schema": { "type": "string", "format": "date" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 5000, "default": 1000 } }
        ],
        "responses": { "200": { "description": "NAV observations returned newest first" }, "400": { "$ref": "#/components/responses/ApiError" } }
      }
    },
    "/funds/{fund_id}/holdings": {
      "get": {
        "tags": ["Funds"],
        "summary": "Get portfolio holdings",
        "description": "Returns holdings for the latest reporting period or the requested report_date. Financial metrics are separately sourced and may be null.",
        "operationId": "getFundHoldings",
        "parameters": [
          { "$ref": "#/components/parameters/FundId" },
          { "name": "report_date", "in": "query", "schema": { "type": "string", "format": "date" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 5000, "default": 1000 } }
        ],
        "responses": { "200": { "description": "Holdings and available report dates returned" }, "400": { "$ref": "#/components/responses/ApiError" }, "404": { "$ref": "#/components/responses/ApiError" } }
      }
    },
    "/etl/runs": {
      "get": {
        "tags": ["ETL"],
        "summary": "List ETL runs",
        "operationId": "listEtlRuns",
        "parameters": [{ "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 } }],
        "responses": { "200": { "description": "Recent runs returned" } }
      },
      "post": {
        "tags": ["ETL"],
        "summary": "Start an ETL run",
        "description": "Starts a run for selected sources, countries, or all registered runnable sources. Only one run can be active at once.",
        "operationId": "startEtlRun",
        "security": [{ "AdminApiKey": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EtlRunRequest" }, "examples": { "selectedSources": { "value": { "sourceIds": ["sec_open_end_fund_classes"] } } } } }
        },
        "responses": {
          "202": { "description": "Run queued" },
          "400": { "$ref": "#/components/responses/ApiError" },
          "401": { "$ref": "#/components/responses/ApiError" },
          "409": { "description": "Another ETL run is already queued or running" }
        }
      }
    },
    "/etl/runs/{run_id}": {
      "get": {
        "tags": ["ETL"],
        "summary": "Get ETL run results",
        "operationId": "getEtlRun",
        "parameters": [{ "name": "run_id", "in": "path", "required": true, "schema": { "type": "string" }, "description": "API UUID or legacy python-N run ID" }],
        "responses": { "200": { "description": "Run details and per-source outcomes returned" }, "404": { "$ref": "#/components/responses/ApiError" } }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "AdminApiKey": { "type": "apiKey", "in": "header", "name": "X-API-Key", "description": "Administrator API key; required for ETL runs and source connectivity checks." }
    },
    "parameters": {
      "FundId": { "name": "fund_id", "in": "path", "required": true, "schema": { "type": "integer", "minimum": 1 } },
      "SourceId": { "name": "source_id", "in": "path", "required": true, "schema": { "type": "string" } }
    },
    "schemas": {
      "EtlRunRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "all": { "type": "boolean", "description": "Run all registered runnable sources" },
          "sourceIds": { "type": "array", "items": { "type": "string" } },
          "countryCodes": { "type": "array", "items": { "type": "string", "minLength": 2, "maxLength": 2 } }
        },
        "description": "Provide all=true, one or more sourceIds, or one or more countryCodes."
      },
      "ApiError": {
        "type": "object",
        "properties": { "error": { "type": "object", "properties": { "code": { "type": "string" }, "message": { "type": "string" } }, "required": ["code", "message"] } },
        "required": ["error"]
      }
    },
    "responses": {
      "ApiError": { "description": "Request failed", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } } },
      "DatabaseUnavailable": { "description": "PostgreSQL is unavailable", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } } }
    }
  }
}
